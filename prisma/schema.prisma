// Database schema for the A3 coach app. See docs/architecture.md, section 5.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String
  signInProvider String    @default("invite") @map("sign_in_provider")
  createdAt      DateTime  @default(now()) @map("created_at")
  sessions       Session[]
  a3s            A3[]
  invitesUsed    Invite[]  @relation("InviteUser")

  @@map("users")
}

// One-time invite links. Only a hash of the token is stored.
model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation("InviteUser", fields: [userId], references: [id])

  @@map("invites")
}

// Signed-in browser sessions. Only a hash of the cookie token is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

model A3 {
  id             String         @id @default(uuid()) @db.Uuid
  ownerId        String         @map("owner_id") @db.Uuid
  owner          User           @relation(fields: [ownerId], references: [id])
  type           String         @default("problem_solving")
  title          String
  status         String         @default("draft")
  pdcaStage      String         @default("plan") @map("pdca_stage")
  currentVersion Int            @default(1) @map("current_version")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  versions       A3Version[]
  drafts         Draft[]
  coachingTurns  CoachingTurn[]
  rawInputs      RawInput[]
  uploads        Upload[]
  reviews        Review[]

  @@index([ownerId])
  @@map("a3s")
}

// Every saved state of an A3, stored whole as JSON (src/lib/a3/schema.ts).
model A3Version {
  id            String   @id @default(uuid()) @db.Uuid
  a3Id          String   @map("a3_id") @db.Uuid
  a3            A3       @relation(fields: [a3Id], references: [id], onDelete: Cascade)
  version       Int
  document      Json
  savedById     String   @map("saved_by") @db.Uuid
  changeSummary String   @map("change_summary")
  // "person", "ai_draft" or "system"
  source        String   @default("person")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([a3Id, version])
  @@map("a3_versions")
}

// AI proposals waiting for the person to accept, edit or reject (phase 3).
model Draft {
  id            String   @id @default(uuid()) @db.Uuid
  a3Id          String   @map("a3_id") @db.Uuid
  a3            A3       @relation(fields: [a3Id], references: [id], onDelete: Cascade)
  fieldPath     String   @map("field_path")
  proposedValue Json     @map("proposed_value")
  sourceQuote   String?  @map("source_quote")
  // "pending", "accepted", "edited" or "rejected"
  state         String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")
  decidedAt     DateTime? @map("decided_at")

  @@index([a3Id, state])
  @@map("drafts")
}

model CoachingTurn {
  id         String   @id @default(uuid()) @db.Uuid
  a3Id       String   @map("a3_id") @db.Uuid
  a3         A3       @relation(fields: [a3Id], references: [id], onDelete: Cascade)
  section    String
  questionId String?  @map("question_id")
  // "core", "probe" or "challenge"
  tag        String?
  // "person" or "coach"
  speaker    String
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([a3Id, createdAt])
  @@map("coaching_turns")
}

// The person's own words, kept exactly as typed.
model RawInput {
  id        String   @id @default(uuid()) @db.Uuid
  a3Id      String   @map("a3_id") @db.Uuid
  a3        A3       @relation(fields: [a3Id], references: [id], onDelete: Cascade)
  section   String?
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("raw_inputs")
}

model Upload {
  id             String   @id @default(uuid()) @db.Uuid
  a3Id           String   @map("a3_id") @db.Uuid
  a3             A3       @relation(fields: [a3Id], references: [id], onDelete: Cascade)
  fileName       String   @map("file_name")
  storageKey     String   @map("storage_key")
  parsedColumns  Json?    @map("parsed_columns")
  mappedMetricId String?  @map("mapped_metric_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("uploads")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  a3Id      String   @map("a3_id") @db.Uuid
  a3        A3       @relation(fields: [a3Id], references: [id], onDelete: Cascade)
  version   Int
  scores    Json
  flags     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}
